{
  "appId": "in.gov.jharkhand.surakshaar",
  "appName": "SurakshaAR Safety Simulator",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "hardwareAcceleration": true
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#020617"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#020617",
      "showSpinner": true,
      "spinnerColor": "#f59e0b"
    }
  }
}
